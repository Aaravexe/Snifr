PORT=3000
# Copy the Atlas Drivers connection string and replace the placeholders.
# Percent-encode reserved characters in the database password.
MONGODB_URI=mongodb+srv://SNIFR_DB_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER_HOST/snifr?retryWrites=true&w=majority&appName=Snifr
MONGO_REQUIRED=true
MONGODB_ATLAS_ONLY=true
